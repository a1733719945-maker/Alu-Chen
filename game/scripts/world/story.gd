## 秘境刻字：秘境是天宫坠下的碎片，墙上留着天上的记录（每章三层，一层一句）
const INSCRIPTIONS := {
	1: ["税簿：人间灵脉，岁取其三。", "天枢星君请减税，不许。", "天枢星君私返灵气，记过一次。"],
	2: ["人间大旱三年，税如旧。", "凡人聚于天坛，其数十万。", "天枢星君请开门议和，不许。"],
	3: ["凡人攻天第三日，第一天阙破。", "天河之螭，下界迎敌。", "天罚已备，待令。"],
	4: ["凡人攻天第七日，令下：天罚。", "天枢星君立于门中，不退。", "天门碎。天枢星君，不知所踪。"],
	5: ["第一重天，塌。", "第二重天，裂。", "九重之上，无人回报。"],
}


static func inscription(chapter: int, tier: int) -> String:
	var a: Array = INSCRIPTIONS.get(chapter, [])
	return str(a[clampi(tier, 0, a.size() - 1)]) if not a.is_empty() else ""


