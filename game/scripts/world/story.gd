## 轮回 / 再叩天：灵主认得你
static func lord_intro(kind: String, tier: int) -> String:
	if tier <= 0:
		return str(LORDS.get(kind, {}).get("intro", ""))
	if tier == 1:
		return "又是你。"
	return "又是你。这是第%s次了？" % NUM[clampi(tier, 0, NUM.size() - 1)]


static func lord(kind: String, key: String) -> String:
	return str(LORDS.get(kind, {}).get(key, ""))


