class_name Story
## 剧情文字（剧本全文在 docs/世界观.md）：灵主台词、天枢记忆、青崖子的话、灵环记忆、秘境刻字、残碑、北斗九重。
##
## 真相要玩家一边玩一边拼：三万年前太初宗在天坛前"叩天"，守门的天枢星君云岫把自己碎成五块关死了天门；
## 五个灵主是替她守碎片、快撑不住的守门者；青崖子就是当年领兵的沈青崖。
## 文字都要短：台词一两句，不超过两行。

const SAGE := "青崖子"

## 北斗九重：轮回 / 再叩天，一重一颗星
const STARS := ["天枢", "天璇", "天玑", "天权", "玉衡", "开阳", "摇光", "洞明", "隐元"]
const NUM := ["一", "二", "三", "四", "五", "六", "七", "八", "九"]


## "第二重天 · 天璇"（tier 0 = 第一重，不写）
static func heaven_name(tier: int) -> String:
	var i := clampi(tier, 0, STARS.size() - 1)
	return "第%s重天 · %s" % [NUM[i], STARS[i]]


